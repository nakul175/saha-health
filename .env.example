# Optional approved HTTP AI providers only. Never commit actual keys.
SAHA_EXTERNAL_APIS_ENABLED=false
SAHA_ALLOWED_ORIGINS=
SAHA_PROVIDER_API_KEY=
# Optional built-in OpenAI evidence adapter. Leave empty until an approved key exists.
OPENAI_API_KEY=

# Programme connections: exact organisation/integration/origin scoped grants.
SAHA_MIS_CONNECTIONS=[]
SAHA_MIS_PARTNER_KEY=
SAHA_MIS_PARTNER_CALLBACK_KEY=

# EHR connections require exact base URL and organisation-scoped grants.
SAHA_EHR_CONNECTIONS=[]
SAHA_EHR_PARTNER_KEY=

# Identity provider (slice 0c). Default keeps Sites/ChatGPT sign-in. For an institutional
# identity provider behind Cloudflare Access set all three; values are not secrets but must match
# the Access application exactly.
SAHA_IDENTITY_PROVIDER=sites-chatgpt
SAHA_ACCESS_TEAM_DOMAIN=
SAHA_ACCESS_AUD=

# Slice 9a: in the synthetic environment a new home organisation receives a demonstration clinical package
# (not clinically approved). Set to manual to turn automatic installation off; owners can still install it.
SAHA_DEMONSTRATION_PACKAGE=

# Independent Anaemia Screen integration, synthetic demonstration only.
# Configure only the private demo deployment; CF staging remains disabled.
SAHA_ANAEMIA_DEMO_ENABLED=false
SAHA_ANAEMIA_DEMO_BOOTSTRAP=false
SAHA_ANAEMIA_ORIGIN=
SAHA_ANAEMIA_API_KEY=
SAHA_ANAEMIA_DISPATCH_TOKEN=
